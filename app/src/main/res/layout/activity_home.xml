<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vs"
            type="com.eveningoutpost.dexdrip.ui.BaseShelf" />

        <variable
            name="home"
            type="com.eveningoutpost.dexdrip.Home" />

        <variable
            name="ui"
            type="com.eveningoutpost.dexdrip.ui.UiPing" />

        <variable
            name="nano"
            type="com.eveningoutpost.dexdrip.utilitymodels.NanoStatus" />

        <variable
            name="expiry"
            type="com.eveningoutpost.dexdrip.utilitymodels.NanoStatus" />

        <import type="android.view.View" />
    </data>

    <androidx.drawerlayout.widget.DrawerLayout

        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.eveningoutpost.dexdrip.Home">

        <!-- Phase 3 "glance panel" layout: toolbar, banner, state-tinted glucose panel,
             chips, time range, chart (+ treatment confirm card overlay), preview, bottom bar. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/xd_bg"
            android:orientation="vertical"
            android:padding="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/my_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize" />

            <!-- banner: only visible while a low prediction is active -->
            <TextView
                android:id="@+id/lowpredict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xd_space_3"
                android:layout_marginEnd="@dimen/xd_space_3"
                android:layout_marginBottom="@dimen/xd_space_2"
                android:background="@drawable/bg_xd_card"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="@dimen/xd_space_3"
                android:paddingEnd="@dimen/xd_space_3"
                android:text="Low prediction"
                android:textColor="@color/xd_urgent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- glance panel: background tint is set from Home (state of the current value) -->
            <LinearLayout
                android:id="@+id/glance_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xd_space_3"
                android:layout_marginEnd="@dimen/xd_space_3"
                android:background="@drawable/bg_xd_glance_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/xd_space_3"
                android:paddingTop="@dimen/xd_space_2"
                android:paddingEnd="@dimen/xd_space_3"
                android:paddingBottom="@dimen/xd_space_3">

                <LinearLayout
                    android:id="@+id/layoutCurrentBgValueRealTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:paddingStart="@dimen/xd_space_3"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentBgValueRealTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="13.3"
                        android:textSize="112sp" />

                    <ImageView
                        android:id="@+id/trendArrow"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="@dimen/xd_space_1"
                        android:background="@android:color/transparent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:showIfTrue="@{safeUnbox(vs.included[`graphic_trend_arrow`])}"
                        app:srcCompat="@drawable/ic_arrow_forward_color_24dp" />
                </LinearLayout>

                <!-- minutes ago, delta and status / alert-disabled messages (all written by Home) -->
                <TextView
                    android:id="@+id/notices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-34dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_horizontal"
                    android:text="@string/alerts"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="@color/xd_urgent"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/extraStatusLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_horizontal"
                    android:text="Extra status line"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textBridgeBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:inputType="none"
                        android:text="Battery Status"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textSize="12sp"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/uploaderbattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/xd_space_2"
                        android:background="@android:color/transparent"
                        android:inputType="none"
                        android:text="Battery Status"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textSize="12sp"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/libstatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/xd_space_2"
                        android:background="@android:color/transparent"
                        android:inputType="none"
                        android:text="Sensor Age"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textSize="12sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <!-- chips: heart rate, steps, vehicle mode (visibility handled by Home) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingTop="@dimen/xd_space_1">

                <ImageButton
                    android:id="@+id/vehicleModeButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/xd_space_2"
                    android:background="@drawable/bg_xd_chip"
                    android:contentDescription="Vehicle mode"
                    android:src="@drawable/ic_car_grey600_24dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bpmButton"
                    style="@style/Widget.Xd.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/xd_space_2"
                    android:onClick="toggleStepsVisibility"
                    android:text="123"
                    android:visibility="gone"
                    app:icon="@drawable/ic_heart_pulse_grey600_24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/walkButton"
                    style="@style/Widget.Xd.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="toggleStepsVisibility"
                    android:text="99999"
                    android:visibility="gone"
                    app:icon="@drawable/ic_walk_grey600_24dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nanoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                app:showIfTrue="@{(safeUnbox(vs.included[`collector_nano_status`]) || safeUnbox(vs.included[`sensor_expiry`]))}">


                <TextView
                    android:id="@+id/nanoStatusText"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="5dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{nano.color_watch, default=`Nano Status`}"
                    app:showIfTrue="@{(safeUnbox(vs.included[`collector_nano_status`] &amp;&amp; nano.color_watch.length() > 0))}"/>

                <TextView
                    android:id="@+id/ExpiryStatusText"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="5dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="@{expiry.color_watch, default=`Expiry Status`}"
                    app:showIfTrue="@{(safeUnbox(vs.included[`sensor_expiry`]) &amp;&amp; (expiry.color_watch.length() > 0))}"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourcewizard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                app:showIfTrue="@{safeUnbox(vs.included[`source_wizard`])}">


                <Button
                    android:id="@+id/sourceWizardButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="sourceWizardButtonClick"
                    android:text="@string/start_source_setup_wizard" />

            </LinearLayout>

            <!-- time range: segmented control. Visibility still comes from the shelf setting,
                 clicks / long-press lock / locked-alpha are unchanged. -->
            <LinearLayout
                android:id="@+id/time_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xd_space_3"
                android:layout_marginTop="@dimen/xd_space_2"
                android:layout_marginEnd="@dimen/xd_space_3"
                android:background="@drawable/bg_xd_segmented"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="@{safeUnbox(vs.included[`time_buttons`]) ? View.VISIBLE: View.GONE}">

                <Button
                    android:id="@+id/hourbutton3"
                    style="@style/Widget.Xd.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:longClickable="true"
                    android:onClick="timeButtonClick"
                    android:onLongClick="@{home::timeButtonLongClick}"
                    android:text="@{@string/hour_format(3)}"
                    app:button_indicate="@{home.isHourLocked(3, ui.ping)}" />

                <Button
                    android:id="@+id/hourbutton6"
                    style="@style/Widget.Xd.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:longClickable="true"
                    android:onClick="timeButtonClick"
                    android:onLongClick="@{home::timeButtonLongClick}"
                    android:text="@{@string/hour_format(6)}"
                    app:button_indicate="@{home.isHourLocked(6, ui.ping)}" />

                <Button
                    android:id="@+id/hourbutton12"
                    style="@style/Widget.Xd.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:longClickable="true"
                    android:onClick="timeButtonClick"
                    android:onLongClick="@{home::timeButtonLongClick}"
                    android:text="@{@string/hour_format(12)}"
                    app:button_indicate="@{home.isHourLocked(12, ui.ping)}" />

                <Button
                    android:id="@+id/hourbutton24"
                    style="@style/Widget.Xd.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:longClickable="true"
                    android:onClick="timeButtonClick"
                    android:onLongClick="@{home::timeButtonLongClick}"
                    android:text="@{@string/hour_format(24)}"
                    app:button_indicate="@{home.isHourLocked(24, ui.ping)}" />

            </LinearLayout>

            <!-- chart area; the treatment confirm card overlays it while a treatment is pending -->
            <FrameLayout
                android:id="@+id/home_layout_holder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/xd_space_2"
                android:layout_weight="1">

                <lecho.lib.hellocharts.view.LineChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/treatmentTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@android:color/transparent"
                    android:gravity="center_horizontal"
                    android:paddingStart="@dimen/xd_space_3"
                    android:paddingEnd="@dimen/xd_space_3"
                    android:text="Treatment voice data appears here"
                    android:textColor="@color/xd_ok"
                    android:textSize="14sp" />

                <!-- shown by Home only while treatment values are pending (approve / cancel) -->
                <LinearLayout
                    android:id="@+id/treatment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_margin="@dimen/xd_space_3"
                    android:background="@drawable/bg_xd_card"
                    android:orientation="vertical"
                    android:padding="@dimen/xd_space_2"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/bloodTestButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Blood test"
                                android:src="@drawable/ic_touch_app_white_48dp" />

                            <TextView
                                android:id="@+id/textBloodGlucose"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="102 mg/dl"
                                android:textColor="@color/xd_ok"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/buttonCarbs"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Carbs"
                                android:src="@drawable/ic_local_dining_white_48dp" />

                            <TextView
                                android:id="@+id/textCarbohydrate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="65 grams"
                                android:textColor="@color/xd_ok"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/buttonInsulin0"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Insulin"
                                android:src="@drawable/ic_colorize_white_48dp" />

                            <TextView
                                android:id="@+id/textInsulinSumUnits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="14 units"
                                android:textColor="@color/xd_ok"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/timeButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Treatment time"
                                android:src="@drawable/ic_av_timer_white_36dp" />

                            <TextView
                                android:id="@+id/textTimeButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="00:00"
                                android:textColor="@color/xd_ok"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- multiple insulin profiles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/buttonInsulin1"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Insulin 1"
                                android:src="@drawable/ic_colorize_white_48dp" />

                            <TextView
                                android:id="@+id/textInsulin1Units"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="14 units"
                                android:textColor="@color/xd_ok"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/buttonInsulin2"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Insulin 2"
                                android:src="@drawable/ic_colorize_white_48dp" />

                            <TextView
                                android:id="@+id/textInsulin2Units"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="14 units"
                                android:textColor="@color/xd_ok"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/buttonInsulin3"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Insulin 3"
                                android:src="@drawable/ic_colorize_white_48dp" />

                            <TextView
                                android:id="@+id/textInsulin3Units"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:text="14 units"
                                android:textColor="@color/xd_ok"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/cancelTreatment"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="Cancel treatment"
                                android:src="@android:drawable/ic_delete" />

                            <ImageButton
                                android:id="@+id/approveTreatment"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="@dimen/xd_space_2"
                                android:contentDescription="Confirm Treatment"
                                android:src="@android:drawable/ic_input_add" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <lecho.lib.hellocharts.view.PreviewLineChartView
                android:id="@+id/chart_preview"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:visibility="@{safeUnbox(vs.included[`chart_preview`]) ? View.VISIBLE: View.GONE}" />

            <!-- bottom bar: Treatment (tap: type, long-press: voice), Note, Undo, Redo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_xd_bottom_bar"
                android:orientation="horizontal"
                android:paddingTop="@dimen/xd_space_1"
                android:paddingBottom="@dimen/xd_space_1">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnTreatment"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/speaktreatment"
                        android:src="@drawable/ic_eyedropper_variant_grey600_24dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xd_bar_treatment"
                        android:textColor="@color/xd_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnNote"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Add note"
                        android:onClick="showNoteTextInputDialog"
                        android:src="@drawable/ic_note_plus_grey600_24dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xd_bar_note"
                        android:textColor="@color/xd_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnUndo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Undo last"
                        android:onClick="undoButtonClick"
                        android:src="@drawable/ic_undo_variant_grey600_24dp" />

                    <TextView
                        android:id="@+id/labelUndo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xd_bar_undo"
                        android:textColor="@color/xd_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnRedo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Redo last"
                        android:onClick="redoButtonClick"
                        android:src="@drawable/ic_redo_variant_grey600_24dp" />

                    <TextView
                        android:id="@+id/labelRedo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/xd_bar_redo"
                        android:textColor="@color/xd_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>


        <fragment
            android:id="@+id/navigation_drawer"
            android:name="com.eveningoutpost.dexdrip.NavigationDrawerFragment"
            class="com.eveningoutpost.dexdrip.NavigationDrawerFragment"
            android:layout_width="@dimen/navigation_drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginTop="?attr/actionBarSize"
            tools:layout="@layout/fragment_navigation_drawer" />
    </androidx.drawerlayout.widget.DrawerLayout>

</layout>
